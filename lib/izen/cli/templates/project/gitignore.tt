# Bundler / gems
/.bundle/
/vendor/bundle/

# Local environment (keep .env.example committed)
.env
.env.*
!.env.example

# Kamal deploy config (kept locally; contains server/registry details and secrets)
# except the native config, which is a tracked, self-contained template.
/config/deploy*.yml
!/config/deploy.native.yml
/.kamal/

# Logs, temp files and test coverage
/log/
/tmp/
/coverage/

# SQLite databases and the session secret
/storage/*.db
/storage/*.db-*
/storage/*.sqlite3
/storage/*.sqlite3-*
/storage/session_secret

# Uploaded files (served at /uploads by the local storage service)
/storage/uploads/*
!/storage/uploads/.gitkeep

# Spinel native build output (`izen native ...`); the Dockerfile.native and
# config/deploy.native.yml that drive it live at the project root instead.
/native/

# Editor and OS noise
.DS_Store
*.swp
.ruby-lsp/
