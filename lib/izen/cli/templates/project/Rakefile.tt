# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs << "test"
  t.test_files = FileList["test/**/*_test.rb", "app/**/*_test.rb"]
  t.warning    = false
end

namespace :db do
  desc "Back up the SQLite database and uploads (optional DIR)"
  task :backup, [ :dir ] do |_t, args|
    require "izen/backup"

    Izen.root = __dir__
    result    = Izen::Backup.run(dir: args[:dir])
    puts "backup #{result[:stamp]}"
    puts "  database: #{result[:database]}"
    puts "  uploads:  #{result[:uploads]}"
  end
end

namespace :native do
  desc "Lower this app to a Spinel project (native/)"
  task :generate do
    sh "bundle exec izen native generate --spinel"
  end

  desc "Build one native binary with Spinel"
  task :build do
    sh "bundle exec izen native build"
  end

  desc "Run the generated app on CRuby (development)"
  task :run do
    sh "bundle exec izen native run"
  end

  desc "Diff this app on CRuby against the compiled native binary"
  task :verify do
    require "izen/native"
    require "izen/native/conformance"

    source    = File.expand_path(__dir__)
    native    = File.join(source, "tmp", "native-verify", "native")
    scenarios = Izen::Native::Conformance.load_scenarios(File.join(source, "test", "native_scenarios.rb"))

    binary    = Izen::Native::Builder.new(source: source, out: native).build
    reference = Izen::Native::Conformance.rack(source, scenarios: scenarios)
    actual    = Izen::Native::Conformance.binary(binary, native, scenarios: scenarios)
    diffs     = Izen::Native::Conformance.differences(reference, actual)

    abort "native parity failed:\n#{diffs.join("\n\n")}" unless diffs.empty?

    puts "native parity OK (#{scenarios.size} scenarios)"
  end
end

task default: :test
