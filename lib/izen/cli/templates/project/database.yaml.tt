# SQLite database path per environment. Values can be interpolated from the
# environment with ERB, the way Rails' config files work:
#
#   production:
#     path: "<%%= ENV.fetch("DATABASE_PATH", "storage/production.db") %>"
development:
  path: storage/development.db

test:
  path: storage/test.db

production:
  path: storage/production.db
