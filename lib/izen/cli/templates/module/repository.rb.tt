# frozen_string_literal: true

module <%= @namespace %>
  # All database access for <%= @namespace %> lives here.
  class Repository < Base::Repository
    def all
      to_models(query("SELECT * FROM <%= @plural %> ORDER BY id DESC"))
    end

    def find(id)
      to_model(find_one("SELECT * FROM <%= @plural %> WHERE id = ? LIMIT 1", [ id ]))
    end

    def create(model)
      row = find_one(<<~SQL, [ <%= @fields.map { |field| bind_value(field) }.join(", ") %> ])
        INSERT INTO <%= @plural %> (<%= @fields.map(&:name).join(", ") %>)
        VALUES (<%= Array.new(@fields.size, "?").join(", ") %>)
        RETURNING *
      SQL
      to_model(row)
    end

    def update(model)
      row = find_one(<<~SQL, [ <%= (@fields.map { |field| bind_value(field) } + ["model.id"]).join(", ") %> ])
        UPDATE <%= @plural %>
        SET <%= (@fields.map { |field| "#{field.name} = ?" } + ["updated_at = datetime('now')"]).join(", ") %>
        WHERE id = ?
        RETURNING *
      SQL
      to_model(row)
    end

    def delete(model)
      db.execute("DELETE FROM <%= @plural %> WHERE id = ?", [ model.id ])
    end
  end
end
