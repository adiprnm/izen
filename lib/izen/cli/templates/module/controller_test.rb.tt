# frozen_string_literal: true

require_relative "../../test/test_helper"

module <%= @namespace %>
  class ControllerTest < TestSupport::ControllerTest
    def test_index
      get "/<%= @plural %>"
      assert_equal 200, last_response.status
    end

    def test_new_renders_the_form
      get "/<%= @plural %>/new"
      assert_equal 200, last_response.status
    end

    def test_create_with_valid_params_redirects
      post "/<%= @plural %>", <%= param_hash_literal %>
      assert_equal 302, last_response.status
      assert_equal "/<%= @plural %>", last_response.headers["location"]
    end
<% if (required = first_required) -%>

    def test_create_with_invalid_params_rerenders
      post "/<%= @plural %>", <%= param_hash_literal(required.name => "") %>
      assert_equal 200, last_response.status
      assert_includes last_response.body, "wajib diisi"
    end
<% end -%>

    def test_show_returns_not_found
      get "/<%= @plural %>/999999"
      assert_equal 404, last_response.status
    end

    def test_update_with_a_put_override_redirects
      item = Repository.new.create(Model.new(<%= model_hash_literal %>))

      post "/<%= @plural %>/#{item.id}", { "_method" => "put" }.merge(<%= param_hash_literal %>)

      assert_equal 302, last_response.status
      assert_equal "/<%= @plural %>", last_response.headers["location"]
    end

    def test_destroy_with_a_delete_override_redirects
      item = Repository.new.create(Model.new(<%= model_hash_literal %>))

      post "/<%= @plural %>/#{item.id}", { "_method" => "delete" }

      assert_equal 302, last_response.status
      assert_equal "/<%= @plural %>", last_response.headers["location"]
    end
  end
end
