<h1><%= @namespace %></h1>

<p><a href="/<%= @name %>/new">Tambah data</a></p>

<ul>
  <%% items.each do |item| %>
    <li>
      <a href="/<%= @name %>/<%%= item.id %>"><%%= item.<%= @primary.name %> %></a>
      <a href="/<%= @name %>/<%%= item.id %>/edit">ubah</a>
      <form method="post" action="/<%= @name %>/<%%= item.id %>/delete" class="inline">
        <button type="submit">hapus</button>
      </form>
    </li>
  <%% end %>
</ul>

<%% if items.empty? %>
  <p>Belum ada data.</p>
<%% end %>
